# 复制为 .env 后填写。没有填的项，相关功能会返回明确的配置错误，
# 不会用假结果冒充成功。

# ── 语音转写 (OpenAI 兼容的 /audio/transcriptions) ─────────────
# 可以指向托管 API，也可以指向院内自建的 Whisper / FunASR 网关
ZS_ASR_PROVIDER=whisper
ZS_ASR_BASE_URL=
ZS_ASR_API_KEY=
ZS_ASR_MODEL=whisper-1
ZS_ASR_LANGUAGE=zh
ZS_ASR_TIMEOUT=180

# ── 大模型 (OpenAI 兼容的 /chat/completions) ───────────────────
# 指向 vLLM / 院内网关即可跑私有化部署的 Qwen、百川
ZS_LLM_BASE_URL=
ZS_LLM_API_KEY=
ZS_LLM_MODEL=qwen2.5-72b-instruct
ZS_LLM_THINKING=
ZS_LLM_TIMEOUT=120
ZS_LLM_TEMPERATURE=0.1

# ── 知识问答模式：placeholder | rag | off ──────────────────────
# placeholder = 明确显示"尚未上线"，不回答任何医学问题（默认）
# rag         = 只依据已导入的授权文档回答，带引用，证据不足即拒答
# off         = 完全关闭该模块
ZS_KB_MODE=placeholder
# 命中率阈值 0~1：最相关片段必须覆盖问题中这一比例的检索词，否则拒答
ZS_KB_MIN_COVERAGE=0.25
ZS_KB_TOP_K=5

# ── 隐私 ───────────────────────────────────────────────────────
# 分析日志保留天数，到期由 POST /api/privacy/purge 清除
ZS_LOG_RETENTION_DAYS=30
# 是否允许在用户勾选同意后保存提问原文（去标识化后）。默认关闭。
ZS_ALLOW_RAW_QUERY_STORAGE=false
# 会话引用的哈希盐。不设置则每次重启轮换，跨重启无法关联。
ZS_LOG_SALT=

# ── 其他 ───────────────────────────────────────────────────────
ZS_MAX_AUDIO_MB=100
ZS_PORT=5173
ZS_HOST=127.0.0.1
